---
import Base from '../layouts/Base.astro';
import TuileLecon from '../components/TuileLecon.astro';
import { leconsVisibles } from '../lib/lecons';
import { boutonsMatieres, boutonsPublics, grouperParMatiere } from '../lecon/filtres';

const lecons = await leconsVisibles();
const publics = boutonsPublics(lecons);
const matieres = boutonsMatieres(lecons);
const groupes = grouperParMatiere(lecons);
const rangees = [
  { nom: 'public', titre: 'Public', boutons: publics.map((p) => ({ valeur: p.id, libelle: p.libelle })) },
  { nom: 'matiere', titre: 'Matière', boutons: matieres.map((m) => ({ valeur: m.matiere, libelle: m.libelle })) },
];
---

<Base titre="Cours" description="Des cours illustrés, faciles à lire." large>
  <h1>Cours</h1>
  {
    lecons.length === 0 ? (
      <p class="chapeau">Aucun cours publié pour l'instant.</p>
    ) : (
      <>
        {/* Masqué sans JavaScript : le script l'affiche. */}
        <div class="filtres" hidden>
          {rangees.map((r) => (
            <div class="filtres-rangee" role="group" aria-labelledby={`filtres-${r.nom}`}>
              <p class="filtres-titre" id={`filtres-${r.nom}`}>
                {r.titre}
              </p>
              <div class="filtres-boutons">
                {r.boutons.map((b) => (
                  <button type="button" class="filtre" aria-pressed="false" data-filtre={r.nom} data-valeur={b.valeur}>
                    <svg class="filtre-coche" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <rect x="2" y="2" width="20" height="20" rx="3" />
                      <path d="M6 12.5l4 4 8-9" />
                    </svg>
                    {b.libelle}
                  </button>
                ))}
              </div>
            </div>
          ))}
          {/* Combinaison vide : le message vient juste avant « Tout voir ». */}
          <div class="message-vide" role="status">
            <p hidden data-message-vide>Aucune leçon ne correspond à ces filtres.</p>
          </div>
          <button type="button" class="filtre filtre-tout" data-tout-voir>
            Tout voir
          </button>
        </div>

        {groupes.map((g) => (
          <section class="groupe-matiere" data-groupe>
            <h2>{g.libelle}</h2>
            <ul class="grille-lecons">
              {g.lecons.map((l) => (
                <TuileLecon lecon={l} />
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</Base>

<script>
  import { activerFiltres } from '../scripts/filtres-accueil';
  activerFiltres();
</script>
