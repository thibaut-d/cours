---
import Base from '../../../layouts/Base.astro';
import FilAriane from '../../../components/FilAriane.astro';
import { leconsVisibles } from '../../../lib/lecons';
import { leconsDeMatiere, matieresDuPublic, publicsPresents, slugLecon } from '../../../lecon/catalogue';
import { lien } from '../../../lib/lien';

export async function getStaticPaths() {
  const lecons = await leconsVisibles();
  return publicsPresents(lecons).flatMap((n) =>
    matieresDuPublic(lecons, n.id).map((m) => ({
      params: { public: n.id, matiere: m.matiere },
      props: { publicActuel: n, matiereLibelle: m.matiereLibelle },
    })),
  );
}

const { publicActuel, matiereLibelle } = Astro.props;
const { matiere } = Astro.params;
const lecons = leconsDeMatiere(await leconsVisibles(), publicActuel.id, matiere);
---

<Base titre={`${matiereLibelle} – ${publicActuel.libelle} – Cours`} description={`Les leçons de ${matiereLibelle} en ${publicActuel.libelle}.`}>
  <FilAriane
    etapes={[
      { libelle: 'Cours', href: lien('?choisir') },
      { libelle: publicActuel.libelle, href: lien(`${publicActuel.id}/`) },
      { libelle: matiereLibelle },
    ]}
  />
  <h1>{matiereLibelle}</h1>
  <ul class="tuiles">
    {
      lecons.map((l) => (
        <li>
          <a class="tuile" href={lien(`${publicActuel.id}/${matiere}/${slugLecon(l.id)}/`)}>{l.data.titre}</a>
        </li>
      ))
    }
  </ul>
</Base>
