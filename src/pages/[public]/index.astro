---
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/FilAriane.astro';
import { leconsVisibles } from '../../lib/lecons';
import { matieresDuPublic, publicsPresents } from '../../lecon/catalogue';
import { lien } from '../../lib/lien';

export async function getStaticPaths() {
  const lecons = await leconsVisibles();
  return publicsPresents(lecons).map((n) => ({ params: { public: n.id }, props: { publicActuel: n } }));
}

const { publicActuel } = Astro.props;
const matieres = matieresDuPublic(await leconsVisibles(), publicActuel.id);
---

<Base titre={`${publicActuel.libelle} – Cours`} description={`Les matières de ${publicActuel.libelle}.`}>
  <FilAriane etapes={[{ libelle: 'Cours', href: lien('?choisir') }, { libelle: publicActuel.libelle }]} />
  <h1 data-niveau={publicActuel.id}>{publicActuel.libelle}</h1>
  <ul class="tuiles">
    {
      matieres.map((m) => (
        <li>
          <a class="tuile" href={lien(`${publicActuel.id}/${m.matiere}/`)}>{m.matiereLibelle}</a>
        </li>
      ))
    }
  </ul>
  <p><a class="tuile tuile-discrete" href={lien('?choisir')}>Changer de niveau</a></p>
</Base>

<script>
  import { ecrireNiveau } from '../../scripts/dernier-niveau';
  const id = document.querySelector<HTMLElement>('[data-niveau]')?.dataset.niveau;
  if (id) ecrireNiveau(id);
</script>
