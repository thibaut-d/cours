---
import Base from '../../../layouts/Base.astro';
import FilAriane from '../../../components/FilAriane.astro';
import { leconsVisibles } from '../../../lib/lecons';
import { leconsDeMatiere, matieresDuNiveau, niveauxPresents, slugLecon } from '../../../lecon/catalogue';
import { lien } from '../../../lib/lien';

export async function getStaticPaths() {
  const lecons = await leconsVisibles();
  return niveauxPresents(lecons).flatMap((n) =>
    matieresDuNiveau(lecons, n.id).map((m) => ({
      params: { niveau: n.id, matiere: m.matiere },
      props: { niveau: n, matiereLibelle: m.matiereLibelle },
    })),
  );
}

const { niveau, matiereLibelle } = Astro.props;
const { matiere } = Astro.params;
const lecons = leconsDeMatiere(await leconsVisibles(), niveau.id, matiere);
---

<Base titre={`${matiereLibelle} – ${niveau.libelle} – Cours`} description={`Les leçons de ${matiereLibelle} en ${niveau.libelle}.`}>
  <FilAriane
    etapes={[
      { libelle: 'Cours', href: lien('?choisir') },
      { libelle: niveau.libelle, href: lien(`${niveau.id}/`) },
      { libelle: matiereLibelle },
    ]}
  />
  <h1>{matiereLibelle}</h1>
  <ul class="tuiles">
    {
      lecons.map((l) => (
        <li>
          <a class="tuile" href={lien(`${niveau.id}/${matiere}/${slugLecon(l.id)}/`)}>{l.data.titre}</a>
        </li>
      ))
    }
  </ul>
</Base>
