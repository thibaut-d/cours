---
import '../styles/global.css';
import Reglages from '../components/Reglages.astro';
import { lien } from '../lib/lien';
import avantAffichage from '../scripts/reglages-avant-affichage.ts?raw';

interface Props {
  titre: string;
  langue?: 'fr' | 'en';
  description?: string;
  /** Page de navigation (accueil) : colonne plus large pour une grille de tuiles. */
  large?: boolean;
}

const { titre, langue = 'fr', description, large = false } = Astro.props;

// Polices de lecture : Luciole (CC BY 4.0), repli Atkinson Hyperlegible. Servies en local, jamais de CDN.
// URL dérivées de la base : Astro ne réécrit pas les url() absolues d'un fichier CSS.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const polices = [
  ['Luciole', 'luciole', 400],
  ['Luciole', 'luciole', 700],
  ['Atkinson Hyperlegible', 'atkinson-hyperlegible', 400],
  ['Atkinson Hyperlegible', 'atkinson-hyperlegible', 700],
] as const;
const faces = polices
  .map(([famille, fichier, graisse]) => `@font-face{font-family:'${famille}';src:url('${base}/fonts/${fichier}-${graisse}.woff2') format('woff2');font-weight:${graisse};font-style:normal;font-display:swap}`)
  .join('\n');
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={lien('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={lien('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={lien('apple-touch-icon.png')} />
    <link rel="manifest" href={lien('manifest.webmanifest')} />
    <style is:inline set:html={faces}></style>
    <script is:inline set:html={avantAffichage}></script>
    <slot name="tete" />
  </head>
  <body>
    <div class:list={['barre', { large }]}>
      <Reglages langue={langue} />
    </div>
    <main class:list={[{ large }]}>
      <slot />
    </main>
  </body>
</html>
